{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/10-letter-words",
      "destination": "https://lettersolver.net/ten-letter-words",
      "permanent": true
    },
    {
      "source": "/9-letter-words",
      "destination": "https://lettersolver.net/nine-letter-words",
      "permanent": true
    },
    {
      "source": "/8-letter-words",
      "destination": "https://lettersolver.net/eight-letter-words",
      "permanent": true
    },
    {
      "source": "/7-letter-words",
      "destination": "https://lettersolver.net/seven-letter-words",
      "permanent": true
    },
    {
      "source": "/6-letter-words",
      "destination": "https://lettersolver.net/six-letter-words",
      "permanent": true
    },
    {
      "source": "/5-letter-words",
      "destination": "https://lettersolver.net/five-letter-words",
      "permanent": true
    },
    {
      "source": "/4-letter-words",
      "destination": "https://lettersolver.net/four-letter-words",
      "permanent": true
    },
    {
      "source": "/3-letter-words",
      "destination": "https://lettersolver.net/three-letter-words",
      "permanent": true
    },
    {
      "source": "/2-letter-words",
      "destination": "https://lettersolver.net/two-letter-words",
      "permanent": true
    },
    {
      "source": "/sitemap-0.xml",
      "destination": "https://lettersolver.net/sitemap.xml",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap-index.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sitemap-0.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sitemap-1.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sitemap-2.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
