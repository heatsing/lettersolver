---
import Layout from '@/layouts/Layout.astro';
import { getMeta } from '@/lib/meta';
import { getWordsByLength } from '@/lib/words-data';
import { getScrabbleScore } from '@/lib/unscramble';
import { wordFinders, dailyGameHints } from '@/lib/nav-links';
import { getLengthPath, LENGTH_SLUGS, type WordLength } from '@/lib/length-slugs';
import WordFinderByLength from '@/components/WordFinderByLength';

export function getStaticPaths() {
  return [2, 3, 4, 5, 6, 7, 8, 9, 10].map((length) => ({
    params: { length: LENGTH_SLUGS[length as WordLength].replace('-letter-words', '') },
    props: { length },
  }));
}

const { length } = Astro.props;
const words = getWordsByLength(length);

const INITIAL_SHOW = 80;
const hasMore = words.length > INITIAL_SHOW;
const initialWords = words.slice(0, INITIAL_SHOW);
const restWords = words.slice(INITIAL_SHOW);

const wordsByAlpha = [...initialWords].sort((a, b) => a.localeCompare(b));
const restByAlpha = [...restWords].sort((a, b) => a.localeCompare(b));
const wordsByPoints = [...initialWords].sort((a, b) => getScrabbleScore(b) - getScrabbleScore(a));
const restByPoints = [...restWords].sort((a, b) => getScrabbleScore(b) - getScrabbleScore(a));

const metaTitle = `${length} Letter Words | Letter Solver`;
const metaDesc = length === 5
  ? `${words.length} valid 5-letter words. Perfect for Wordle and daily word games. Browse A-Z or by score, or use the finder to search by letters.`
  : length === 7
  ? `${words.length} seven-letter words. Great for Scrabble bingos and Words with Friends. Browse the list or search by your tiles.`
  : `Browse ${words.length} ${length}-letter words. Use the finder to search by letters, or sort A-Z or by Scrabble score.`;
const meta = getMeta(getLengthPath(length), metaTitle, metaDesc);

const lengthsNav = [10, 9, 8, 7, 6, 5, 4, 3, 2];
const frequentSearches = length === 5
  ? ['wordle', 'crane', 'slate', 'trace', 'audio']
  : length === 7
  ? ['scrabble', 'bingo', 'letters', 'anagram', 'unscramble']
  : ['words', 'letters', 'finder', 'unscramble', 'games'];

const wordFindersList = [...dailyGameHints, ...wordFinders];
const lengthGuides: Record<number, {
  popular: string[];
  scrabble: string[];
  friends: string[];
  count: string;
  intro: string;
  everyday: string;
  reason: string;
}> = {
  2: {
    popular: ['Am', 'Be', 'Go', 'If', 'Up'],
    scrabble: ['QI', 'ZA', 'XI'],
    friends: ['JO', 'OX', 'EX'],
    count: 'more than 100',
    intro: 'Tiny words can decide big games. Two-letter words are the secret doorways of Scrabble, Words With Friends, and tight crossword grids because they let you connect tiles in places longer words cannot reach.',
    everyday: 'They look simple, but short words carry a lot of strategic weight. Once you know the useful ones, cramped boards suddenly become much easier to play.',
    reason: 'Learning two-letter words helps you score in narrow spaces, build parallel plays, and turn awkward tiles into useful points.',
  },
  3: {
    popular: ['Cat', 'Sun', 'Run', 'Map', 'Win'],
    scrabble: ['ZAX', 'QAT', 'JOW'],
    friends: ['ZEK', 'JIZ', 'XIS'],
    count: 'more than 1,000',
    intro: 'Three-letter words are compact, flexible, and surprisingly powerful. They give word game players quick ways to connect ideas, unlock board space, and rescue turns that look stuck.',
    everyday: 'Many three-letter words show up constantly in conversation, puzzles, and game boards. Their value comes from how easily they fit almost anywhere.',
    reason: 'Learning three-letter words improves pattern recognition, expands your playable options, and makes small openings on the board much more valuable.',
  },
  4: {
    popular: ['Play', 'Word', 'Game', 'Quiz', 'Help'],
    scrabble: ['QUIZ', 'JAZZ', 'ZYME'],
    friends: ['ZOUK', 'JINX', 'FOXY'],
    count: 'more than 4,000',
    intro: 'Four-letter words are the workhorses of word games. They are long enough to score well, short enough to fit into tight spaces, and common enough to appear in everyday language.',
    everyday: 'A strong four-letter vocabulary makes puzzles feel faster and board games feel less restrictive because so many useful patterns are only a few letters long.',
    reason: 'Learning four-letter words helps you spot hooks, extend existing words, and turn ordinary tiles into clean scoring chances.',
  },
  5: {
    popular: ['About', 'Other', 'World', 'Point', 'Brain'],
    scrabble: ['JAZZY', 'ZAPPY', 'QUACK'],
    friends: ['ZONKS', 'JUKED', 'XYLYL'],
    count: 'more than 12,000',
    intro: 'Five-letter words sit at the center of modern word play. They matter in Wordle, crosswords, anagrams, Scrabble, and almost every puzzle where a balanced word length gives you room to think.',
    everyday: 'Because so many familiar words have five letters, this length is one of the easiest places to build real vocabulary momentum.',
    reason: 'Learning five-letter words sharpens guessing strategy, improves spelling instincts, and gives you more ways to test patterns quickly.',
  },
  6: {
    popular: ['Letter', 'Puzzle', 'Friend', 'Solver', 'Scores'],
    scrabble: ['QUARTZ', 'JAZZED', 'ZEPHYR'],
    friends: ['JINXED', 'QUEAZY', 'ZONKED'],
    count: 'more than 20,000',
    intro: 'Six-letter words give players a useful balance of reach and control. They are long enough to create strong scores, but still flexible enough to fit into many puzzle and board positions.',
    everyday: 'You will find six-letter words everywhere in normal writing, which makes them easier to learn through repeated exposure.',
    reason: 'Learning six-letter words helps you prepare for longer plays, recognize common endings, and build confidence with multi-syllable vocabulary.',
  },
  7: {
    popular: ['Another', 'Letters', 'Playing', 'Winning', 'Meaning'],
    scrabble: ['JUKEBOX', 'QUIZZED', 'ZOMBIFY'],
    friends: ['ZIZZLED', 'JAZZILY', 'QUACKED'],
    count: 'more than 30,000',
    intro: 'Seven-letter words are famous in Scrabble because using all seven tiles can unlock a bingo bonus. They also make anagrams and word puzzles feel more rewarding.',
    everyday: 'Many seven-letter words are familiar enough to remember, but long enough to create serious scoring swings.',
    reason: 'Learning seven-letter words improves anagram solving, helps you see prefixes and suffixes faster, and raises your ceiling in competitive word games.',
  },
  8: {
    popular: ['Building', 'Friendly', 'Question', 'Language', 'Strategy'],
    scrabble: ['JAZZIEST', 'OXIDIZER', 'QUIXOTIC'],
    friends: ['ZUCCHINI', 'JACKPOTS', 'MAXIMIZE'],
    count: 'more than 40,000',
    intro: 'Eight-letter words bring vocabulary into bigger territory. They can open long lanes, transform puzzle grids, and create satisfying plays when several letters finally click together.',
    everyday: 'This length is common in books, articles, and games, so learning eight-letter words builds both practical vocabulary and puzzle confidence.',
    reason: 'Learning eight-letter words helps you manage complex patterns, spot compound structures, and turn partial letter sets into stronger answers.',
  },
  9: {
    popular: ['Challenge', 'Different', 'Important', 'Knowledge', 'Something'],
    scrabble: ['MAXIMIZES', 'JAZZINESS', 'QUICKLIME'],
    friends: ['VAJAZZLED', 'ZIGZAGGED', 'JACKFRUIT'],
    count: 'more than 45,000',
    intro: 'Nine-letter words feel substantial without becoming impossible. They reward pattern memory, strong spelling, and the ability to see how smaller word parts combine.',
    everyday: 'A lot of useful nine-letter words come from common prefixes, suffixes, and root words, so they become easier once you learn the shapes.',
    reason: 'Learning nine-letter words improves longer anagram solving, strengthens vocabulary range, and prepares you for advanced puzzle clues.',
  },
  10: {
    popular: ['Strawberry', 'Friendship', 'Everything', 'Appreciate', 'Motivation'],
    scrabble: ['RAZZMATAZZ', 'DIZZYINGLY', 'MAXIMIZING'],
    friends: ['RAZZMATAZZ', 'VAJAZZLING', 'JAZZERCISE'],
    count: 'roughly 35,000',
    intro: 'Step into the arena of 10-letter words, where vocabulary becomes a secret weapon and every extra letter feels like unlocking a treasure chest full of points. Whether you are chasing victory in Scrabble, dominating Words With Friends, or flexing your brainpower in word puzzles, mastering longer words can completely change your game.',
    everyday: 'And the best part? Some of these words appear in everyday conversation more often than you realize.',
    reason: 'Building your knowledge of longer words is not just about games. It sharpens spelling skills, improves communication, and boosts pattern recognition.',
  },
};
const guide = lengthGuides[length];
---

<Layout meta={meta} wide>
  <!--
  Tool sidebar + main content layout for N-letter word lists.
  -->
  <div class="letter-words-grid">
    <aside class="md:col-start-1 md:row-start-1 flex flex-col gap-4 md:gap-6 sticky top-20 md:top-24 self-start w-full md:min-w-0 md:border-l md:border-border md:pl-4" aria-label="Tool sidebar: search and other tools">
      <section class="rounded-lg border border-border bg-card overflow-hidden" aria-label="Word Finder">
        <WordFinderByLength client:load length={length} />
      </section>
      <nav class="rounded-lg border border-border bg-card p-4">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3">Word length</h2>
        <ul class="space-y-1 list-none pl-0">
          {lengthsNav.map((len) => (
            <li>
              <a
                href={getLengthPath(len)}
                class:list={[
                  'block rounded-md px-3 py-2.5 text-sm font-medium transition-colors',
                  len === length ? 'bg-primary text-white' : 'text-foreground hover:bg-muted hover:text-primary',
                ]}
              >
                {len}-Letter Words
              </a>
            </li>
          ))}
        </ul>
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide mt-6 mb-3">Frequent Searches</h2>
        <ul class="space-y-1 list-none pl-0">
          {frequentSearches.map((term) => (
            <li>
              <a
                href={`/unscramble?q=${encodeURIComponent(term)}`}
                class="block rounded-md px-3 py-2 text-sm text-foreground hover:bg-muted hover:text-primary transition-colors"
              >
                {term}
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 pt-4 border-t border-border text-xs text-muted-foreground">
          <a href="/words-by-length" class="text-primary hover:underline">All lengths</a>
        </p>
      </nav>
      <section class="rounded-lg border border-border bg-card p-4">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3">Word Finders</h2>
        <ul class="space-y-2 list-none pl-0 text-sm">
          {wordFindersList.map((item) => (
            <li>
              <a href={item.href} class="text-foreground hover:text-primary transition-colors block">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </aside>

    <div class="md:col-start-2 md:row-start-1 min-w-0 w-full" role="region" aria-label="Main content: SEO text and word list">
      <header class="mb-6">
        <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-3">{length} Letter Words</h1>
        <p class="text-muted-foreground leading-relaxed max-w-2xl">
          Word games like Words with Friends, Scrabble, and Wordle are more popular than ever. {length}-letter words are a great fit for daily puzzles and board games. Browse the full list below or use the word finder on the left to search by letters and filters.
        </p>
      </header>

      <section class="mb-8" aria-labelledby="word-list-heading">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
          <h2 id="word-list-heading" class="text-xl font-semibold text-foreground">{length} letter words</h2>
          <div class="flex items-center gap-2">
            <label for="sort-words" class="text-sm text-muted-foreground">Sort:</label>
            <select id="sort-words" class="rounded-lg border border-border bg-card px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary" aria-label="Sort word list">
              <option value="alpha">A-Z</option>
              <option value="points">Points</option>
            </select>
          </div>
        </div>
        <div id="word-list-grid" class="grid gap-2 grid-cols-2 sm:grid-cols-4">
          {wordsByAlpha.map((w) => (
            <a
              href={`/unscramble?q=${encodeURIComponent(w)}`}
              class="word-card p-3 rounded-lg border border-border bg-card hover:bg-muted hover:border-primary text-foreground text-center font-medium lowercase transition-colors"
              data-word={w}
              data-points={getScrabbleScore(w)}
            >
              <span class="word-label">{w}</span>
              <span class="word-points text-muted-foreground text-xs ml-1" aria-hidden="true">{getScrabbleScore(w)}</span>
            </a>
          ))}
        </div>
        {hasMore && (
          <div class="mt-4" id="more-container">
            <button
              type="button"
              id="load-more-btn"
              class="px-5 py-2.5 rounded-lg bg-primary text-white font-medium border border-primary hover:bg-primary/90 transition-colors min-h-[2.75rem]"
            >
              Load more
            </button>
          </div>
        )}
      </section>

      <article class="mb-10 space-y-8 text-foreground">
        <section class="rounded-lg border border-border bg-card p-5 sm:p-6">
          <h2 class="text-xl sm:text-2xl font-bold text-foreground mb-3">About {length}-Letter Words</h2>
          <div class="space-y-4 text-base leading-7 text-muted-foreground">
            <p>
              At WordSphere, we make it easy to turn scrambled letters into powerful {length}-letter words for your favorite word games. Whether you're playing Scrabble, Words With Friends, or solving word puzzles, our word finder helps you discover high-scoring words in seconds.
            </p>
            <p>
              Find stronger plays, improve your vocabulary, and make the most of every turn. From common words to advanced combinations, you'll always have more possibilities at your fingertips.
            </p>
          </div>
        </section>

        <section class="rounded-lg border border-border bg-card p-5 sm:p-6">
          <h2 class="text-xl sm:text-2xl font-bold text-foreground mb-3">The WordVault Guide to {length}-Letter Words</h2>
          <div class="space-y-4 text-base leading-7 text-muted-foreground">
            <p>{guide.intro}</p>
            <p>
              At WordVault, you can uncover useful word combinations, expand your vocabulary, and discover hidden gems that turn ordinary plays into better scoring chances.
            </p>
            <p>{guide.everyday}</p>
          </div>
        </section>

        <section class="rounded-lg border border-border bg-card p-5 sm:p-6">
          <h2 class="text-xl sm:text-2xl font-bold text-foreground mb-3">The Most Popular {length}-Letter Words</h2>
          <p class="text-base leading-7 text-muted-foreground mb-4">
            Some {length}-letter words are easy to recognize because they appear often in daily reading, conversation, and word puzzles. Here are a few familiar examples:
          </p>
          <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3 list-none pl-0 mb-4">
            {guide.popular.map((word) => (
              <li class="rounded-md border border-border bg-background px-4 py-3 font-semibold text-foreground">
                {word}
              </li>
            ))}
          </ul>
          <p class="text-base leading-7 text-muted-foreground">
            These are just a small sample from the larger collection of {length}-letter vocabulary. Once you start noticing the patterns, this word length becomes easier to spot across books, games, and conversations.
          </p>
        </section>

        <section class="rounded-lg border border-border bg-card p-5 sm:p-6">
          <h2 class="text-xl sm:text-2xl font-bold text-foreground mb-3">Why Learn {length}-Letter Words?</h2>
          <p class="text-base leading-7 text-muted-foreground mb-4">
            {guide.reason} In word games specifically, this length can:
          </p>
          <ul class="grid gap-3 sm:grid-cols-2 list-none pl-0 mb-4">
            {[
              'Create stronger scoring opportunities',
              'Open difficult board positions',
              'Improve pattern recognition',
              'Increase your puzzle-solving speed',
              'Expand your overall vocabulary',
            ].map((benefit) => (
              <li class="flex gap-3 rounded-md bg-muted px-4 py-3 text-sm font-medium text-foreground">
                <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>
          <p class="text-base leading-7 text-muted-foreground">
            A well-timed {length}-letter word can shift a puzzle or game from stuck to solved.
          </p>
        </section>

        <section class="rounded-lg border border-border bg-card p-5 sm:p-6">
          <h2 class="text-xl sm:text-2xl font-bold text-foreground mb-3">High-Scoring {length}-Letter Words in Scrabble</h2>
          <div class="space-y-4 text-base leading-7 text-muted-foreground">
            <p>Some {length}-letter words are valuable because they use rare letters, create hooks, or fit into tight board positions.</p>
            <p>A few useful examples include:</p>
          </div>
          <ul class="my-4 grid gap-2 sm:grid-cols-3 list-none pl-0">
            {guide.scrabble.map((word) => (
              <li class="rounded-md border border-primary/30 bg-primary/10 px-4 py-3 text-center font-bold tracking-wide text-primary">
                {word}
              </li>
            ))}
          </ul>
          <p class="text-base leading-7 text-muted-foreground">
            Words with high-value letters like Z, X, Q, and J can create excellent scoring opportunities when they land on premium squares or connect with existing words.
          </p>
        </section>

        <section class="rounded-lg border border-border bg-card p-5 sm:p-6">
          <h2 class="text-xl sm:text-2xl font-bold text-foreground mb-3">Top {length}-Letter Words in Words With Friends</h2>
          <div class="space-y-4 text-base leading-7 text-muted-foreground">
            <p>
              Words With Friends allows a broader dictionary than traditional Scrabble, which means creative word choices can appear more often.
            </p>
            <p>Some standout examples include:</p>
          </div>
          <ul class="my-4 grid gap-2 sm:grid-cols-3 list-none pl-0">
            {guide.friends.map((word) => (
              <li class="rounded-md border border-border bg-background px-4 py-3 text-center font-bold tracking-wide text-foreground">
                {word}
              </li>
            ))}
          </ul>
          <p class="text-base leading-7 text-muted-foreground">
            Knowing flexible {length}-letter options gives you more ways to respond when the board gets crowded or your tiles feel awkward.
          </p>
        </section>

        <section class="rounded-lg border border-border bg-card p-5 sm:p-6">
          <h2 class="text-xl sm:text-2xl font-bold text-foreground mb-4">Frequently Asked Questions</h2>
          <div class="space-y-3">
            <div class="rounded-md border border-border bg-background p-4">
              <h3 class="text-base font-semibold text-foreground mb-2">How many {length}-letter words exist?</h3>
              <p class="text-sm sm:text-base leading-7 text-muted-foreground">
                The English language contains {guide.count} {length}-letter words, though the exact number varies depending on the dictionary being used. Word games often use smaller approved word lists, meaning not every dictionary word is playable.
              </p>
            </div>
            <div class="rounded-md border border-border bg-background p-4">
              <h3 class="text-base font-semibold text-foreground mb-2">Are {length}-letter words difficult to memorize?</h3>
              <p class="text-sm sm:text-base leading-7 text-muted-foreground">
                Not necessarily. Many are already part of normal daily vocabulary. Once you begin practicing word patterns, prefixes, suffixes, and common letter pairs, this length becomes much easier to recognize.
              </p>
            </div>
          </div>
        </section>
      </article>

      <script define:vars={{ wordsByAlpha, wordsByPoints, restByAlpha, restByPoints, hasMore }}>
        (function () {
          const grid = document.getElementById('word-list-grid');
          const sortSelect = document.getElementById('sort-words');
          const loadBtn = document.getElementById('load-more-btn');
          if (!grid || !sortSelect) return;

          var SCRABBLE = { a:1,b:3,c:3,d:2,e:1,f:4,g:2,h:4,i:1,j:8,k:5,l:1,m:3,n:1,o:1,p:3,q:10,r:1,s:1,t:1,u:1,v:4,w:4,x:8,y:4,z:10 };
          function score(w) {
            var s = 0;
            for (var i = 0; i < w.length; i++) s += SCRABBLE[w[i]] || 0;
            return s;
          }
          function wordCardHtml(w, pts) {
            return '<a href="/unscramble?q=' + encodeURIComponent(w) + '" class="word-card p-3 rounded-lg border border-border bg-card hover:bg-muted hover:border-primary text-foreground text-center font-medium lowercase transition-colors"><span class="word-label">' + w + '</span><span class="word-points text-muted-foreground text-xs ml-1" aria-hidden="true">' + pts + '</span></a>';
          }
          function renderList(words) {
            return words.map(function (w) { return wordCardHtml(w, score(w)); }).join('');
          }

          var loaded = false;
          var sortBy = sortSelect.value;

          function getInitial() { return sortBy === 'points' ? wordsByPoints : wordsByAlpha; }
          function getRest() { return sortBy === 'points' ? restByPoints : restByAlpha; }

          function refreshGrid() {
            grid.innerHTML = renderList(getInitial());
            if (loaded && hasMore) grid.innerHTML += renderList(getRest());
          }

          sortSelect.addEventListener('change', function () {
            sortBy = this.value;
            refreshGrid();
          });

          if (loadBtn && hasMore) {
            loadBtn.addEventListener('click', function () {
              grid.innerHTML += renderList(getRest());
              loadBtn.remove();
              loaded = true;
            });
          }
        })();
      </script>

    </div>
  </div>
</Layout>
