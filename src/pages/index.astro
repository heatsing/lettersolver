---
import Layout from '@/layouts/Layout.astro';
import WordsStartWithTool from '@/components/WordsStartWithTool';
import { getMeta, DEFAULT_TITLE, DEFAULT_DESCRIPTION } from '@/lib/meta';

const meta = getMeta('/', DEFAULT_TITLE, DEFAULT_DESCRIPTION);

const fiveLetterLinks = [
  '5 Letter Words Starting with B',
  '5 Letter Words Starting with BE',
  '5 Letter Words Starting with BEG',
  '5 Letter Words with the Letter U',
  '5 Letter Words with the Letter EGU',
  '5 Letter Words with the Letter G',
  '5 Letter Words with the Letter EU',
  '5 Letter Words with the Letter E',
  '5 Letter Words with the Letter EG',
  '5 Letter Words with the Letter GU',
  '5 Letter Words Ending In UN',
  '5 Letter Words Ending In N',
  '5 Letter Words Ending In GUN',
];

const today = new Date();
const dateLabel = today.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const dailyHintsWithMeta = [
  { name: 'Connections', subtitle: 'Hints for each category & today\'s answers', href: '/jumble-solver', icon: '🧩' },
  { name: 'Wordle Hints', subtitle: 'Hints to crack today\'s puzzle', href: '/wordle', icon: '🟩' },
  { name: 'Pips Hints', subtitle: 'Domino solutions & tips', href: '/crossword-solver', icon: '🎲' },
  { name: 'Strands Hints', subtitle: 'Theme & spangram revealed', href: '/word-search-solver', icon: '🧶' },
  { name: 'Mini Crossword Answers', subtitle: 'All clues & answers', href: '/crossword-solver', icon: '🧠' },
  { name: 'Spelling Bee Answers', subtitle: 'Word list & pangrams', href: '/word-unscrambler', icon: '🐝' },
  { name: 'Contexto Answer', subtitle: 'Hints & secret word', href: '/word-finder', icon: '🧩' },
  { name: 'Capture Hints', subtitle: 'Step-by-step solutions', href: '/crossword-solver', icon: '🧭' },
];

const gameHelpers = [
  { name: 'NYT Crossplay Solver', href: '/nyt-crossplay-solver', description: 'Find answers and options for NYT-style crossplay puzzles.' },
  { name: 'Wordle Solver', href: '/wordle-solver', description: 'Narrow down Wordle guesses with green, yellow, and gray clues.' },
  { name: 'Word Unscramble', href: '/unscramble', description: 'Unscramble mixed letters into valid words with wildcard support.' },
  { name: 'Word Scramble Solver', href: '/word-scramble', description: 'Solve jumbled classroom, newspaper, and mobile word scramble puzzles.' },
  { name: 'Anagram Solver', href: '/anagram-solver', description: 'Rearrange letters into every possible anagram, sorted for quick scanning.' },
  { name: 'Scrabble Solver', href: '/scrabble', description: 'Find high-scoring Scrabble words from your rack and board pattern.' },
  { name: 'Wordle', href: '/wordle', description: 'Daily Wordle help, hints, and word lists for five-letter puzzles.' },
  { name: 'Play Wordle', href: '/play-wordle', description: 'Play a clean daily Wordle-style challenge on Letter Solver.' },
  { name: 'Wordle Unlimited', href: '/wordle-unlimited', description: 'Practice unlimited five-letter Wordle games with fresh answers.' },
  { name: 'Scrabble Cheat', href: '/scrabble-cheat', description: 'Quick Scrabble help for valid plays, blanks, and scoring.' },
  { name: 'Scrabble Go', href: '/scrabble-go', description: 'Solve Scrabble Go racks and spot stronger mobile plays.' },
  { name: 'Words With Friends', href: '/words-with-friends', description: 'Find WWF words with useful rack and pattern support.' },
  { name: 'Wordfeud', href: '/wordfeud', description: 'Build better Wordfeud plays from your available letters.' },
  { name: 'Boggle Solver', href: '/boggle-solver', description: 'Enter a Boggle board and uncover every valid word path.' },
  { name: 'Text Twist', href: '/text-twist', description: 'Unscramble Text Twist letters and find every hidden word.' },
  { name: 'Wordscapes', href: '/wordscapes', description: 'Solve Wordscapes levels from wheel letters and patterns.' },
  { name: 'Word Cookies', href: '/word-cookies', description: 'Find missing Word Cookies answers from your cookie letters.' },
  { name: 'Jumble Solver', href: '/jumble-solver', description: 'Unscramble newspaper and mobile Jumble puzzle letters.' },
  { name: 'Letter Boxed Solver', href: '/letter-boxed-solver', description: 'Solve NYT Letter Boxed with efficient word chains.' },
  { name: 'Crossword Solver', href: '/crossword-solver', description: 'Search crossword answers by clue, length, and known letters.' },
  { name: 'Word Search Solver', href: '/word-search-solver', description: 'Find hidden words in letter grids and word search puzzles.' },
  { name: 'Hangman Solver', href: '/hangman-solver', description: 'Use known letters and blanks to solve Hangman words faster.' },
  { name: 'Word Finder', href: '/word-finder', description: 'Search playable words by letters, length, score, and filters.' },
  { name: 'Word Solver', href: '/word-solver', description: 'Use one flexible solver for racks, patterns, blanks, and puzzle clues.' },
  { name: 'Word Generator', href: '/word-generator', description: 'Generate useful random words for games, writing, and vocabulary practice.' },
  { name: 'Descrambler', href: '/descrambler', description: 'Clean up scrambled letter sets and reveal matching dictionary words.' },
];
---

<Layout meta={meta} fullBleed={true}>
  <div class="home-clone">
    <section class="home-hero">
      <div class="home-hero-inner">
        <h1 class="home-h1">Word Finder</h1>
        <p class="home-sub">Enter your letters to find words for Wordle, Scrabble, Words With Friends, anagrams, and crosswords.</p>
        <WordsStartWithTool client:load />
        <p class="home-hero-note">
          Use up to 3 wildcards with filters for starts with, ends with, contains, and word length to turn any rack or puzzle pattern into valid words.
        </p>
      </div>
    </section>

    <section class="home-section">
      <div class="home-wrap">
        <h2 class="home-h2">Word Finder for Every Game</h2>
        <p class="home-muted">
          This free word finder helps you unscramble letters, discover high-scoring Scrabble plays, solve Wordle patterns, and browse word lists by length, prefix, suffix, or included letters.
        </p>
      </div>
    </section>

    <section class="home-section alt">
      <div class="home-wrap">
        <h2 class="home-h2">5 Letter Words</h2>
        <p class="home-muted">5-letter word lists built for puzzle solving</p>
        <ul class="home-link-grid">
          {fiveLetterLinks.map((label) => (
            <li><a href="/words-by-length">{label}</a></li>
          ))}
          <li><a href="/words-start-with">Words that start with</a></li>
          <li><a href="/words-with-letters">Words with letters</a></li>
          <li><a href="/words-ending-in">Words ending in</a></li>
        </ul>
      </div>
    </section>

    <section class="home-section">
      <div class="home-wrap">
        <h2 class="home-h2">Word Games</h2>
        <p class="home-muted">Fun daily word games made by Wordtips</p>
        <div class="card-grid">
          <a class="game-card" href="/crossword-solver">
            <h3>WT Mini Crossword</h3>
            <p>Like NYT Mini, but free. Forever. No paywall.</p>
            <span>Play</span>
          </a>
          <a class="game-card" href="/wordle-unlimited">
            <h3>WordQuest</h3>
            <p>Unlimited Wordle with streaks & powerups.</p>
            <span>Play</span>
          </a>
          <a class="game-card" href="/wordle">
            <h3>WordQuest Daily</h3>
            <p>Today's puzzle with points and hints.</p>
            <span>Play</span>
          </a>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="home-wrap">
        <h2 class="home-h2">Daily Word Games Hints & Answers</h2>
        <p class="home-muted">Keep your streak alive. Daily help for daily puzzles.</p>
        <div class="daily-grid">
          {dailyHintsWithMeta.map((item) => (
            <a class="daily-item" href={item.href}>
              <div class="daily-item-top">
                <span class="daily-item-icon" aria-hidden="true">{item.icon}</span>
                <div>
                  <strong>{item.name}</strong>
                  <span>{item.subtitle}</span>
                </div>
              </div>
              <em>{dateLabel}</em>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section alt">
      <div class="home-wrap">
        <div class="section-heading centered">
          <h2 class="home-h2">Popular Word Games Solvers & Helpers</h2>
          <p class="home-muted">Quick links to every game solver, daily puzzle helper, and word-finding tool on Letter Solver.</p>
        </div>
        <div class="card-grid">
          {gameHelpers.map((tool) => (
            <a class="game-card" href={tool.href}>
              <h3>{tool.name}</h3>
              <p>{tool.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>

</Layout>

<style>
  .home-clone { background: var(--background); color: var(--foreground); }
  .home-hero {
    background: linear-gradient(135deg, #79AE6F 0%, #346739 100%);
    padding: 2rem 1rem 2.75rem;
  }
  .home-hero-inner {
    max-width: 44rem;
    margin: 0 auto;
  }
  .home-h1 {
    margin: 0;
    text-align: center;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .home-sub {
    margin: 0.5rem 0 1.5rem;
    text-align: center;
    color: rgb(255 255 255 / 0.9);
    font-weight: 600;
  }
  .home-hero-note {
    margin: 1rem auto 0;
    max-width: 42rem;
    text-align: center;
    color: rgb(255 255 255 / 0.9);
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .home-section { padding: 2.25rem 1rem; }
  .home-section.alt { background: var(--muted); }
  .home-wrap { max-width: 72rem; margin: 0 auto; }
  .home-h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.35rem, 2.5vw, 2rem);
    font-weight: 800;
  }
  .home-muted { margin: 0 0 1rem; color: var(--muted-foreground); }
  .section-heading {
    margin-bottom: 1.25rem;
  }
  .section-heading.centered {
    max-width: 44rem;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }
  .section-heading .home-muted {
    margin-bottom: 0;
    line-height: 1.6;
  }
  .home-link-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.65rem;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }
  .home-link-grid a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
  }
  .home-link-grid a:hover { text-decoration: underline; }
  .card-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .game-card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    padding: 1rem;
    background: var(--card);
    text-decoration: none;
    color: inherit;
  }
  .game-card h3 { margin: 0 0 0.35rem; font-size: 1.05rem; font-weight: 800; }
  .game-card p { margin: 0; color: var(--muted-foreground); line-height: 1.55; }
  .game-card span { display: inline-block; margin-top: 0.75rem; color: var(--color-primary); font-weight: 700; }
  .daily-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .daily-item {
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 0.8rem;
    background: var(--card);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .daily-item-top {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }
  .daily-item-icon {
    width: 1.4rem;
    height: 1.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .daily-item strong { font-size: 0.95rem; }
  .daily-item span { color: var(--muted-foreground); font-size: 0.86rem; display: block; margin-top: 0.05rem; }
  .daily-item em {
    color: var(--muted-foreground);
    opacity: 0.8;
    font-size: 0.78rem;
    font-style: normal;
    margin-top: 0.25rem;
  }
</style>
